{
  "name": "@coregraph/viz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Single-file 3D viewer for coregraph json-graph exports",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "node server.mjs",
    "test": "vitest run",
    "data": "coregraph -C .. export --format json-graph | node scripts/embed-data.mjs"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "^5.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-force-graph-3d": "^1.29.1",
    "three": "^0.182.0",
    "three-spritetext": "^1.10.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.0",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.8"
  }
}
